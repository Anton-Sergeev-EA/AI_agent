# Конфигурация ассистента.

# Основные настройки.
ASSISTANT_NAME=Алекс
LANGUAGE=ru-RU
USE_SPEECH=true
USE_AI=false

# API ключи (получите на соответствующих сайтах).
# OPENWEATHER_API_KEY=ваш_ключ_здесь
# NEWS_API_KEY=ваш_ключ_здесь

# Настройки речи.
SPEECH_RATE=150
VOLUME=1.0

# Команды активации (через запятую).
WAKE_WORDS=алекс,помощник,эй
EXIT_WORDS=стоп,выход,закончить
